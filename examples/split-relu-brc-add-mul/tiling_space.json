{
  "kernel": "ewop_broadcast_split",
  "kernel_file": "step8_kernel.cpp",
  "soc": "Ascend910B1",
  "block_dim_expr": "ceil(HM / TB_M)",
  "tiling_params": [
    {
      "name": "TB_M",
      "type": "int64",
      "min": 16, "max": 16, "step": 16,
      "note": "HM=320 must be TB_M multiple; DataCopy requires >= 16 elements"
    },
    {
      "name": "TB_N",
      "type": "int64",
      "values": [16],
      "note": "Inner row batch = TB_M (1 inner iteration per TB block)"
    },
    {"name": "dim_arg0_1", "type": "int64", "fixed": true, "shape_key": "N",
     "note": "input_a col dim = N; N must be multiple of 16 (DataCopy f16 alignment)"},
    {"name": "dim_arg1_0", "type": "int64", "fixed": true, "shape_key": "HM",
     "note": "bias0 size = M/2"},
    {"name": "dim_arg0_0", "type": "int64", "fixed": true, "shape_key": "M",
     "note": "input_a row dim = M"},
    {"name": "dim_arg1_1", "type": "int64", "fixed": true, "shape_key": "HM",
     "note": "bias0 stride (unused)"},
    {"name": "dim_arg3_0", "type": "int64", "fixed": true, "shape_key": "N",
     "note": "scale0 size = N"},
    {"name": "dim_arg3_1", "type": "int64", "fixed": true, "shape_key": "N",
     "note": "scale0 (unused)"},
    {"name": "dim_arg2_0", "type": "int64", "fixed": true, "shape_key": "HM",
     "note": "bias1 size = M/2"},
    {"name": "dim_arg2_1", "type": "int64", "fixed": true, "shape_key": "HM",
     "note": "bias1 (unused)"},
    {"name": "dim_arg4_0", "type": "int64", "fixed": true, "shape_key": "N",
     "note": "scale1 size = N"},
    {"name": "dim_arg4_1", "type": "int64", "fixed": true, "shape_key": "N",
     "note": "scale1 (unused)"}
  ]
}
