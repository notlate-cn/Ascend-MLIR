{
  "kernel": "fc_relu",
  "kernel_file": "output_step7_kernel.cpp",
  "soc": "Ascend910B1",
  "block_dim_expr": "ceil(M / TB_M) * ceil(N / TB_N)",
  "tiling_params": [
    {
      "name": "TB_M",
      "type": "int64",
      "min": 128, "max": 128, "step": 128,
      "note": "Inter-core M tile; M=512 must be multiple of TB_M=128"
    },
    {
      "name": "TB_N",
      "type": "int64",
      "min": 128, "max": 128, "step": 128,
      "note": "Inter-core N tile; N=640 must be multiple of TB_N=128"
    },
    {
      "name": "Tb_M",
      "type": "int64",
      "min": 64, "max": 64, "step": 64,
      "note": "Intra-core UB M tile; UB = 3*Tb_M*Tb_N*4 = 98304B < 192KB"
    },
    {
      "name": "Tb_N",
      "type": "int64",
      "min": 128, "max": 128, "step": 128,
      "note": "Intra-core UB N tile = TB_N (single step per core)"
    },
    {
      "name": "t_K",
      "type": "int64",
      "min": 64, "max": 64, "step": 64,
      "note": "K tile for L0A/L0B; K=256 must be multiple of t_K=64"
    },
    {"name": "dim_arg3_0", "type": "int64", "fixed": true, "shape_key": "M",
     "note": "output.shape[0] = M"},
    {"name": "dim_arg3_1", "type": "int64", "fixed": true, "shape_key": "N",
     "note": "output.shape[1] = N"},
    {"name": "dim_arg0_1", "type": "int64", "fixed": true, "shape_key": "K",
     "note": "A.shape[1] = K"},
    {"name": "dim_arg0_0", "type": "int64", "fixed": true, "shape_key": "M",
     "note": "A.shape[0] = M"},
    {"name": "dim_arg1_0", "type": "int64", "fixed": true, "shape_key": "K",
     "note": "B.shape[0] = K"},
    {"name": "dim_arg1_1", "type": "int64", "fixed": true, "shape_key": "N",
     "note": "B.shape[1] = N"},
    {"name": "dim_arg2_0", "type": "int64", "fixed": true, "shape_key": "M",
     "note": "bias.shape[0] = M"},
    {"name": "dim_arg2_1", "type": "int64", "fixed": true, "shape_key": "N",
     "note": "bias.shape[1] = N"}
  ],
  "shapes": {
    "M": 512,
    "K": 256,
    "N": 640
  }
}
