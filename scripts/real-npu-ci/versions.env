# Version pins for the generic aarch64 validation image.
#
# Update this file when the shared build dependency stack changes. PyAsc itself
# follows the source repo/ref under validation; rebuild this image when PyAsc
# requires a different LLVM/MLIR or new system packages.

ASCEND_MLIR_CI_DEFAULT_IMAGE=ascend-mlir-builder:aarch64-ubuntu22.04
ASCEND_MLIR_CI_DEFAULT_LLVM_IMAGE=ascend-mlir-builder:aarch64-ubuntu22.04-llvm21
ASCEND_MLIR_CI_DEFAULT_REMOTE_IMAGE=swr.cn-east-2.myhuaweicloud.com/ascendmlir/ascend-mlir-builder:aarch64-ubuntu22.04-llvm21
ASCEND_MLIR_CI_DEFAULT_CCACHE_ROOT=/data/nyh/ccache
ASCEND_MLIR_CI_BASE_IMAGE=ubuntu:22.04

ASCEND_MLIR_CI_LLVM_REPO_URL=https://github.com/llvm/llvm-project.git
ASCEND_MLIR_CI_LLVM_REF=2078da43e25a4623cab2d0d60decddf709aaea28
ASCEND_MLIR_CI_LLVM_VERSION_LABEL=llvm-21.1.8
ASCEND_MLIR_CI_LLVM_BUILD_TYPE=Release
ASCEND_MLIR_CI_LLVM_ENABLE_ASSERTIONS=ON

# Python packages required by LLVM/MLIR Python bindings and lit-friendly tooling:
# numpy pybind11 nanobind PyYAML pygments
